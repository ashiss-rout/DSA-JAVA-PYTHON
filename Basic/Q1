# Calculate and return the sum of all prime numbers between m and n 


def sum(m,n):
  s=0
  for i in range(m,n+1):
    if is_prime(i):
      s+=i
  return s
def is_prime(j):
    if j <= 1:
        return False

    for i in range(2,(j//2) + 1):
        if j % i == 0:
            return False

    return True
m=int(input("enter no1"))
n=int(input("enter no2"))
print(sum(m,n))
